{
  "outputDirectory": "public",
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.7.4"
    }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.php" },
    { "src": "/(profile|skill|follow|news|stack|project|login|dashboard)(/.*)?", "dest": "/index.html" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
